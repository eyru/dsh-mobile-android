# 已签名的浏览器会话 cookie —— 等同于一把能访问本机 DSH 的钥匙。
# 由 tools/dsh-mint-cookie.mjs 生成，有效期 30 天。
cookie.json
_中间件/cookie.json

# 签名密钥（本地自签用；构建脚本会在缺失时自动重建）
*.keystore
*.jks

# ══════════════════════════════════════════════════════════════
#  体积：本地工具链与构建产物（约 1 GB，不入库）
# ══════════════════════════════════════════════════════════════
_中间件/toolchain/
_中间件/build/
build/
*.flat
*.apk.idsig

# ══════════════════════════════════════════════════════════════
#  个人文件
# ══════════════════════════════════════════════════════════════
